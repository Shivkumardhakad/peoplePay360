generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  HR_MANAGER
  PAYROLL_MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ScheduleDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum RuleCategoryType {
  EARNING
  DEDUCTION
  AGGREGATE
}

enum ComputationType {
  FIXED
  PERCENTAGE
  FORMULA
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

enum TimeOffUnit {
  DAYS
  HOURS
}

enum TimeOffStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  REMOTE
  EXCEPTION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  employeeId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id])
  approvedRequests TimeOffRequest[] @relation("LeaveApprover")
  userRoles UserRoleAssignment[]
  payruns Payrun[]
}

model Employee {
  id             String           @id @default(cuid())
  employeeNumber String           @unique
  firstName      String
  lastName       String
  email          String           @unique
  phone          String?
  dateOfBirth    DateTime?
  gender         String?
  address        String?
  bankAccountId  String?          @unique
  departmentId   String?
  jobPositionId  String?
  hireDate       DateTime
  status         EmploymentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  department      Department?      @relation(fields: [departmentId], references: [id])
  jobPosition     JobPosition?     @relation(fields: [jobPositionId], references: [id])
  users           User[]
  contracts       Contract[]
  attendance      Attendance[]
  allocations     Allocation[]
  timeOffRequests TimeOffRequest[]
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  payslips Payslip[]
}

model BankAccount {
  id            String   @id @default(cuid())
  accountName   String
  accountNumber String
  bankName      String
  routingCode   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee?
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  positions JobPosition[]
  contracts Contract[]
}

model JobPosition {
  id           String   @id @default(cuid())
  departmentId String?
  code         String   @unique
  title        String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  employees  Employee[]
  contracts  Contract[]
}

model Contract {
  id                  String         @id @default(cuid())
  employeeId          String
  positionId          String?
  departmentId        String?
  workingScheduleId   String?
  salaryStructureId   String?
  employmentType      EmploymentType @default(FULL_TIME)
  title               String
  startDate           DateTime
  endDate             DateTime?
  baseSalary          Decimal        @db.Decimal(12, 2)
  wage                Decimal?       @db.Decimal(15, 2)
  weeklyHours         Decimal        @db.Decimal(5, 2)
  currency            String         @default("USD")
  payrollProfileCode  String
  status              ContractStatus @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  position JobPosition? @relation(fields: [positionId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  workingSchedule WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  payslips Payslip[]

  @@index([employeeId, startDate, endDate])
  @@index([payrollProfileCode])
}

model WorkingSchedule {
  id          String   @id @default(cuid())
  name        String   @unique
  weeklyHours Decimal  @db.Decimal(5, 2)
  days        Json
  code        String? @unique
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendance Attendance[]
  scheduleDays WorkingScheduleDay[]
  contracts Contract[]
}

model WorkingScheduleDay {
  id String @id @default(cuid())
  workingScheduleId String
  dayOfWeek ScheduleDay
  startTime String?
  endTime String?
  breakMinutes Int @default(0)
  isWorkingDay Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workingSchedule WorkingSchedule @relation(fields: [workingScheduleId], references: [id], onDelete: Cascade)
  @@unique([workingScheduleId, dayOfWeek])
}

model TimeOffType {
  id                 String      @id @default(cuid())
  name               String      @unique
  unit               TimeOffUnit @default(DAYS)
  requiresAllocation Boolean     @default(true)
  paid               Boolean     @default(true)
  approvalRequired   Boolean     @default(true)
  code               String?     @unique
  payrollBehavior    String      @default("PAID")
  description        String?
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  allocations Allocation[]
  requests    TimeOffRequest[]
}

model Allocation {
  id            String   @id @default(cuid())
  employeeId    String
  timeOffTypeId String
  periodStart   DateTime
  periodEnd     DateTime
  allocated      Decimal  @db.Decimal(8, 2)
  consumed       Decimal  @default(0) @db.Decimal(8, 2)
  remaining      Decimal? @db.Decimal(8, 2)
  validFrom      DateTime?
  validTo        DateTime?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  timeOffType TimeOffType @relation(fields: [timeOffTypeId], references: [id])

  @@unique([employeeId, timeOffTypeId, periodStart, periodEnd])
}

model TimeOffRequest {
  id            String        @id @default(cuid())
  employeeId    String
  timeOffTypeId String
  startDate     DateTime
  endDate       DateTime
  quantity      Decimal       @db.Decimal(8, 2)
  status        TimeOffStatus @default(SUBMITTED)
  reason        String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  timeOffType TimeOffType @relation(fields: [timeOffTypeId], references: [id])
  approvedBy User? @relation("LeaveApprover", fields: [approvedById], references: [id])
}

model Attendance {
  id                String           @id @default(cuid())
  employeeId        String
  workingScheduleId String?
  date              DateTime
  checkIn           DateTime?
  checkOut          DateTime?
  breakMinutes      Int              @default(0)
  workedMinutes     Int              @default(0)
  status            AttendanceStatus @default(PRESENT)
  corrected         Boolean          @default(false)
  correctionReason  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  employee        Employee         @relation(fields: [employeeId], references: [id])
  workingSchedule WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])

  @@unique([employeeId, date])
}

model SalaryStructure {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  contracts   Contract[]
  rules       SalaryStructureRule[]
  payruns     Payrun[]
}

model SalaryRuleCategory {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  type        RuleCategoryType
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rules       SalaryRule[]
  payslipLines PayslipLine[]
}

model SalaryRule {
  id             String         @id @default(cuid())
  name           String
  code           String         @unique
  categoryId     String
  sequence       Int
  calculationType ComputationType
  value          Decimal?       @db.Decimal(15, 4)
  formula        String?        @db.Text
  status         RecordStatus   @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       SalaryRuleCategory @relation(fields: [categoryId], references: [id])
  structures     SalaryStructureRule[]
  payslipLines   PayslipLine[]
}

model SalaryStructureRule {
  id                 String         @id @default(cuid())
  salaryStructureId  String
  salaryRuleId       String
  sequence            Int
  createdAt           DateTime       @default(now())
  salaryStructure    SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  salaryRule         SalaryRule      @relation(fields: [salaryRuleId], references: [id], onDelete: Cascade)
  @@unique([salaryStructureId, salaryRuleId])
}

model Payrun {
  id                 String         @id @default(cuid())
  name               String
  periodStart        DateTime
  periodEnd          DateTime
  salaryStructureId  String
  status             PayrunStatus   @default(DRAFT)
  computedAt         DateTime?
  validatedAt        DateTime?
  paidAt             DateTime?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  salaryStructure    SalaryStructure @relation(fields: [salaryStructureId], references: [id])
  createdBy          User?          @relation(fields: [createdById], references: [id])
  payslips           Payslip[]
}

model Payslip {
  id              String         @id @default(cuid())
  payrunId        String
  employeeId      String
  contractId      String
  periodStart     DateTime
  periodEnd       DateTime
  grossAmount     Decimal        @db.Decimal(15, 2)
  deductionAmount Decimal        @db.Decimal(15, 2)
  netAmount       Decimal        @db.Decimal(15, 2)
  status          PayslipStatus  @default(DRAFT)
  pdfPath         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  payrun          Payrun         @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employee        Employee       @relation(fields: [employeeId], references: [id])
  contract        Contract       @relation(fields: [contractId], references: [id])
  lines           PayslipLine[]
  @@unique([payrunId, employeeId])
}

model PayslipLine {
  id         String             @id @default(cuid())
  payslipId  String
  salaryRuleId String?
  code       String
  name       String
  categoryId String
  sequence   Int
  quantity   Decimal?           @db.Decimal(15, 4)
  rate       Decimal?           @db.Decimal(15, 4)
  amount     Decimal            @db.Decimal(15, 2)
  createdAt  DateTime           @default(now())
  payslip    Payslip            @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryRule SalaryRule?        @relation(fields: [salaryRuleId], references: [id])
  category   SalaryRuleCategory @relation(fields: [categoryId], references: [id])
}

model Role {
  id String @id @default(cuid())
  name String @unique
  description String?
  createdAt DateTime @default(now())
  permissions RolePermission[]
  users UserRoleAssignment[]
}

model Permission {
  id String @id @default(cuid())
  name String @unique
  resource String
  action String
  description String?
  roles RolePermission[]
}

model RolePermission {
  id String @id @default(cuid())
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id String @id @default(cuid())
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId])
  @@map("user_roles")
}
