generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  HR_MANAGER
  PAYROLL_MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum TimeOffUnit {
  DAYS
  HOURS
}

enum TimeOffStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  REMOTE
  EXCEPTION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  employeeId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id])
}

model Employee {
  id             String           @id @default(cuid())
  employeeNumber String           @unique
  firstName      String
  lastName       String
  email          String           @unique
  departmentId   String?
  jobPositionId  String?
  hireDate       DateTime
  status         EmploymentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  department      Department?      @relation(fields: [departmentId], references: [id])
  jobPosition     JobPosition?     @relation(fields: [jobPositionId], references: [id])
  users           User[]
  contracts       Contract[]
  attendance      Attendance[]
  allocations     Allocation[]
  timeOffRequests TimeOffRequest[]
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  positions JobPosition[]
}

model JobPosition {
  id           String   @id @default(cuid())
  departmentId String?
  code         String   @unique
  title        String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  employees  Employee[]
}

model Contract {
  id                  String         @id @default(cuid())
  employeeId          String
  title               String
  startDate           DateTime
  endDate             DateTime?
  baseSalary          Decimal        @db.Decimal(12, 2)
  weeklyHours         Decimal        @db.Decimal(5, 2)
  currency            String         @default("USD")
  payrollProfileCode  String
  status              ContractStatus @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, startDate, endDate])
  @@index([payrollProfileCode])
}

model WorkingSchedule {
  id          String   @id @default(cuid())
  name        String   @unique
  weeklyHours Decimal  @db.Decimal(5, 2)
  days        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendance Attendance[]
}

model TimeOffType {
  id                 String      @id @default(cuid())
  name               String      @unique
  unit               TimeOffUnit @default(DAYS)
  requiresAllocation Boolean     @default(true)
  paid               Boolean     @default(true)
  approvalRequired   Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  allocations Allocation[]
  requests    TimeOffRequest[]
}

model Allocation {
  id            String   @id @default(cuid())
  employeeId    String
  timeOffTypeId String
  periodStart   DateTime
  periodEnd     DateTime
  allocated      Decimal  @db.Decimal(8, 2)
  consumed       Decimal  @default(0) @db.Decimal(8, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  timeOffType TimeOffType @relation(fields: [timeOffTypeId], references: [id])

  @@unique([employeeId, timeOffTypeId, periodStart, periodEnd])
}

model TimeOffRequest {
  id            String        @id @default(cuid())
  employeeId    String
  timeOffTypeId String
  startDate     DateTime
  endDate       DateTime
  quantity      Decimal       @db.Decimal(8, 2)
  status        TimeOffStatus @default(SUBMITTED)
  reason        String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  timeOffType TimeOffType @relation(fields: [timeOffTypeId], references: [id])
}

model Attendance {
  id                String           @id @default(cuid())
  employeeId        String
  workingScheduleId String?
  date              DateTime
  checkIn           DateTime?
  checkOut          DateTime?
  breakMinutes      Int              @default(0)
  workedMinutes     Int              @default(0)
  status            AttendanceStatus @default(PRESENT)
  corrected         Boolean          @default(false)
  correctionReason  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  employee        Employee         @relation(fields: [employeeId], references: [id])
  workingSchedule WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])

  @@unique([employeeId, date])
}
